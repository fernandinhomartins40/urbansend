      "description": "Disparar um novo envio transacional"
    },
    {
      "name": "Analytics",
      "short_name": "Analytics",
      "url": "/app/analytics?source=pwa",
      "description": "Acompanhar entrega e engajamento"
    },
    {
      "name": "Dominios",
      "short_name": "Dominios",
      "url": "/app/domains?source=pwa",
      "description": "Autenticacao SPF, DKIM e DMARC"
    }
  ]
