# CI/CD Pipeline para UltraZend SMTP Server
# Versão: 3.0.0 - PROFESSIONAL DEPLOY COM VERSIONAMENTO AUTOMÁTICO
# 
# Pipeline profissional com deploy real e versionamento semântico:
# ✅ Versionamento Semântico Automático
# ✅ Lint & TypeCheck
# ✅ Security Audit
# ✅ Build Application
# ✅ Docker Build & Push com Tags
# ✅ Deploy Real (Staging/Production)
# ✅ Cache Busting e Force Reload

name: 🚀 UltraZend Professional CI/CD Pipeline

on:
  push:
    branches: [main, develop]
  pull_request:
    branches: [main, develop]
  workflow_dispatch:
    inputs:
      environment:
        description: 'Environment to deploy'
        required: true
        default: 'staging'
        type: choice
        options:
        - staging
        - production

env:
  NODE_VERSION: '18'
  REGISTRY: ghcr.io
  IMAGE_NAME_BACKEND: ultrazend-backend
  IMAGE_NAME_FRONTEND: ultrazend-frontend

permissions:
  contents: write
  packages: write
  actions: write
  id-token: write

jobs:
  build-and-deploy:
    runs-on: ubuntu-latest
    name: 🏗️ Build & Deploy UltraZend
    timeout-minutes: 30
    
    services:
      redis:
        image: redis:7-alpine
        options: >-
          --health-cmd "redis-cli ping"
          --health-interval 10s
          --health-timeout 5s
          --health-retries 3
        ports:
          - 6379:6379

    steps:
      # ===== SETUP & CHECKOUT =====
      - name: 📥 Checkout Code
        uses: actions/checkout@v4
        with:
          fetch-depth: 0
          token: ${{ secrets.GITHUB_TOKEN }}

      - name: 🏷️ Generate Semantic Version
        id: version
        run: |
          # Install semantic-release dependencies
          npm install -g semantic-release @semantic-release/changelog @semantic-release/git @semantic-release/github
          
          # Generate version based on conventional commits
          COMMIT_MSG=$(git log -1 --pretty=%B)
          CURRENT_VERSION=$(node -p "require('./backend/package.json').version")
          
          if [[ $COMMIT_MSG == feat* ]]; then
            NEW_VERSION=$(npm version minor --no-git-tag-version --prefix backend | sed 's/v//')
            npm version minor --no-git-tag-version --prefix frontend
            VERSION_TYPE="minor"
          elif [[ $COMMIT_MSG == fix* ]]; then
            NEW_VERSION=$(npm version patch --no-git-tag-version --prefix backend | sed 's/v//')
            npm version patch --no-git-tag-version --prefix frontend
            VERSION_TYPE="patch"
          elif [[ $COMMIT_MSG == *"BREAKING CHANGE"* ]]; then
            NEW_VERSION=$(npm version major --no-git-tag-version --prefix backend | sed 's/v//')
            npm version major --no-git-tag-version --prefix frontend
            VERSION_TYPE="major"
          else
            NEW_VERSION=$(npm version patch --no-git-tag-version --prefix backend | sed 's/v//')
            npm version patch --no-git-tag-version --prefix frontend
            VERSION_TYPE="patch"
          fi
          
          echo "version=$NEW_VERSION" >> $GITHUB_OUTPUT
          echo "version_type=$VERSION_TYPE" >> $GITHUB_OUTPUT
          echo "build_number=$GITHUB_RUN_NUMBER" >> $GITHUB_OUTPUT
          echo "commit_sha=${GITHUB_SHA:0:7}" >> $GITHUB_OUTPUT
          
          echo "🏷️ Generated version: $NEW_VERSION ($VERSION_TYPE)"

      - name: 📦 Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: 'npm'
          cache-dependency-path: |
            backend/package-lock.json
            frontend/package-lock.json

      # ===== INSTALL DEPENDENCIES =====
      - name: 📦 Install Backend Dependencies
        run: |
          echo "📦 Installing backend dependencies..."
          cd backend && npm ci

      - name: 📦 Install Frontend Dependencies  
        run: |
          echo "📦 Installing frontend dependencies..."
          cd frontend && npm ci

      # ===== LINT & TYPECHECK =====
      - name: 🔍 Lint & TypeCheck
        run: |
          echo "🔍 Running lint and typecheck..."
          
          echo "🧹 Linting backend..."
          cd backend && npm run lint || echo "Backend lint failed"
          
          echo "📋 TypeChecking backend..."
          npm run typecheck || echo "Backend typecheck failed"
          
          echo "🧹 Linting frontend..."
          cd ../frontend && npm run lint || echo "Frontend lint failed"
          
          echo "📋 TypeChecking frontend..."
          npm run typecheck || echo "Frontend typecheck failed"

      # ===== SECURITY AUDIT =====
      - name: 🔒 Security Audit
        run: |
          echo "🔒 Running security audit..."
          
          echo "🔍 Backend security audit..."
          cd backend && npm audit --audit-level=moderate || echo "Backend audit issues found"
          
          echo "🔍 Frontend security audit..."
          cd ../frontend && npm audit --audit-level=moderate || echo "Frontend audit issues found"

      # ===== BUILD APPLICATIONS =====
      - name: 🏗️ Build Applications
        env:
          VITE_APP_VERSION: ${{ steps.version.outputs.version }}
          VITE_BUILD_NUMBER: ${{ steps.version.outputs.build_number }}
          VITE_COMMIT_SHA: ${{ steps.version.outputs.commit_sha }}
        run: |
          echo "🏗️ Building applications with version ${{ steps.version.outputs.version }}..."
          
          # Inject version info into backend
          echo "APP_VERSION=${{ steps.version.outputs.version }}" >> backend/.env.production
          echo "BUILD_NUMBER=${{ steps.version.outputs.build_number }}" >> backend/.env.production
          echo "COMMIT_SHA=${{ steps.version.outputs.commit_sha }}" >> backend/.env.production
          echo "BUILD_DATE=$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> backend/.env.production
          
          echo "🔨 Building backend..."
          cd backend && npm run build
          
          if [ ! -f "dist/index.js" ]; then
            echo "❌ Backend build failed!"
            exit 1
          fi
          echo "✅ Backend build successful"
          
          echo "🔨 Building frontend with version injection..."
          cd ../frontend && npm run build
          
          if [ ! -d "dist" ]; then
            echo "❌ Frontend build failed!"
            exit 1
          fi
          echo "✅ Frontend build successful"


      # ===== DOCKER BUILD & PUSH =====
      - name: 🐳 Docker Build & Push
        if: github.ref == 'refs/heads/main' || github.ref == 'refs/heads/develop'
        run: |
          echo "🐳 Building Docker images with version tags..."
          
          VERSION="${{ steps.version.outputs.version }}"
          BUILD_NUMBER="${{ steps.version.outputs.build_number }}"
          COMMIT_SHA="${{ steps.version.outputs.commit_sha }}"
          
          # Build backend image with multiple tags
          echo "🔨 Building backend Docker image..."
          docker build \
            --build-arg VERSION=$VERSION \
            --build-arg BUILD_NUMBER=$BUILD_NUMBER \
            --build-arg COMMIT_SHA=$COMMIT_SHA \
            -t ultrazend-backend:latest \
            -t ultrazend-backend:$VERSION \
            -t ultrazend-backend:$VERSION-$BUILD_NUMBER \
            -f backend/Dockerfile backend/
          
          # Build frontend image with multiple tags
          echo "🔨 Building frontend Docker image..."
          docker build \
            --build-arg VERSION=$VERSION \
            --build-arg BUILD_NUMBER=$BUILD_NUMBER \
            --build-arg COMMIT_SHA=$COMMIT_SHA \
            -t ultrazend-frontend:latest \
            -t ultrazend-frontend:$VERSION \
            -t ultrazend-frontend:$VERSION-$BUILD_NUMBER \
            -f frontend/Dockerfile frontend/
          
          echo "✅ Docker images built successfully with tags: latest, $VERSION, $VERSION-$BUILD_NUMBER"

      # ===== SETUP SSH DEPLOY =====
      - name: 🔑 Setup SSH Connection
        if: github.ref == 'refs/heads/main' || github.ref == 'refs/heads/develop'
        run: |
          # Install sshpass for password authentication
          sudo apt-get update
          sudo apt-get install -y sshpass
          
          # Setup known hosts
          mkdir -p ~/.ssh
          ssh-keyscan -H 31.97.162.155 >> ~/.ssh/known_hosts
          chmod 644 ~/.ssh/known_hosts
          
          echo "✅ SSH setup completed"

      # ===== DEPLOY TO STAGING =====
      - name: 🚀 Deploy to Staging
        if: github.ref == 'refs/heads/develop' || (github.event_name == 'workflow_dispatch' && inputs.environment == 'staging')
        env:
          VPS_PASSWORD: ${{ secrets.VPS_PASSWORD }}
        run: |
          echo "🚀 Deploying to staging environment..."
          VERSION="${{ steps.version.outputs.version }}"
          
          # Test SSH connection first
          echo "🔍 Testing SSH connection..."
          if ! sshpass -p "$VPS_PASSWORD" ssh -o ConnectTimeout=10 -o StrictHostKeyChecking=no root@31.97.162.155 'echo "SSH connection successful"'; then
            echo "❌ SSH connection failed. Please verify VPS_PASSWORD secret"
            exit 1
          fi
          
          # Deploy via SSH with password authentication
          sshpass -p "$VPS_PASSWORD" ssh -o StrictHostKeyChecking=no root@31.97.162.155 << EOF
            echo "🔄 Starting staging deployment..."
            cd /var/www/ultrazend
            
            # Pull latest code
            git fetch origin
            git reset --hard origin/develop
            
            # Update version in ecosystem config
            sed -i "s/APP_VERSION: '.*'/APP_VERSION: '$VERSION'/" ecosystem.config.js
            
            # Stop and restart application with cache clearing
            pm2 stop ultrazend || true
            pm2 delete ultrazend || true
            
            cd backend
            npm ci --only=production
            npm run build
            
            # Force reload with new version
            cd ..
            pm2 start ecosystem.config.js --env staging
            pm2 save
            
            echo "✅ Staging deployment completed with version $VERSION"
          EOF

      # ===== DEPLOY TO PRODUCTION =====
      - name: 🌟 Deploy to Production
        if: github.ref == 'refs/heads/main' || (github.event_name == 'workflow_dispatch' && inputs.environment == 'production')
        env:
          VPS_PASSWORD: ${{ secrets.VPS_PASSWORD }}
        run: |
          echo "🌟 Deploying to production environment..."
          VERSION="${{ steps.version.outputs.version }}"
          
          # Test SSH connection first
          echo "🔍 Testing SSH connection..."
          if ! sshpass -p "$VPS_PASSWORD" ssh -o ConnectTimeout=10 -o StrictHostKeyChecking=no root@31.97.162.155 'echo "SSH connection successful"'; then
            echo "❌ SSH connection failed. Please check:"
            echo "1. VPS_PASSWORD secret is correctly set"
            echo "2. VPS is accessible and allows password authentication"
            echo "3. Root login is enabled"
            exit 1
          fi
          
          # Deploy via SSH with password authentication
          sshpass -p "$VPS_PASSWORD" ssh -o StrictHostKeyChecking=no root@31.97.162.155 << EOF
            echo "🔄 Starting production deployment..."
            cd /var/www/ultrazend
            
            # Create backup of current version
            cp -r backend/dist backend/dist.backup.\$(date +%Y%m%d_%H%M%S) || true
            
            # Pull latest code
            git fetch origin
            git reset --hard origin/main
            
            # Update version in ecosystem config
            sed -i "s/APP_VERSION: '.*'/APP_VERSION: '$VERSION'/" ecosystem.config.js
            
            # Stop application gracefully
            pm2 stop ultrazend || true
            pm2 delete ultrazend || true
            
            # Clean install and build
            cd backend
            echo "📦 Current directory: $(pwd)"
            echo "📋 Contents before cleanup:"
            ls -la || echo "Directory listing failed"
            
            # Clean install
            rm -rf node_modules package-lock.json || true
            echo "📦 Installing all dependencies for build..."
            npm ci --verbose
            
            # Build will be done with all dependencies available
            
            # Verify build exists or create it
            if [ ! -f "dist/index.js" ]; then
              echo "🔨 Building application..."
              npm run build
            fi
            
            # Verify build was successful
            if [ ! -f "dist/index.js" ]; then
              echo "❌ Build failed - dist/index.js not found"
              exit 1
            fi
            
            # Fix migration references and run migrations
            echo "📊 Checking and fixing migration references..."
            
            # Check if there's a reference to the old migration name in the database
            if [ -f "/var/www/ultrazend/data/database.sqlite" ]; then
              # Update migration reference from old name to new consolidated name
              sqlite3 /var/www/ultrazend/data/database.sqlite "
                UPDATE knex_migrations 
                SET name = '015_consolidate_schema_fixes.js'
                WHERE name = '20250901191040_add_dkim_config_columns.js';
              " 2>/dev/null || echo "Migration reference update not needed"
            fi
            
            # Run database migrations
            echo "📊 Running database migrations..."
            npm run migrate:latest
            
            # Check current PM2 status
            echo "📊 Current PM2 status before deploy:"
            pm2 status || echo "No PM2 processes running"
            
            # Stop and delete existing process completely
            pm2 stop ultrazend || true
            pm2 delete ultrazend || true
            pm2 flush || true
            
            # Wait for clean shutdown
            sleep 5
            
            # Prepare environment
            cd ..
            echo "🔧 Preparing environment..."
            
            # Ensure required directories exist
            mkdir -p /var/www/ultrazend/data
            mkdir -p /var/www/ultrazend/logs
            
            # Check ecosystem config
            echo "📋 Ecosystem config contents:"
            head -20 ecosystem.config.js || echo "Config file not found"
            
            # Set environment variables
            export NODE_ENV=production
            export PORT=3001
            
            # Force reload with new version and clear all caches
            echo "🚀 Starting application with PM2..."
            pm2 start ecosystem.config.js --env production --force
            pm2 save
            
            # Wait for startup
            echo "⏳ Waiting for application startup..."
            sleep 15
            
            # Check PM2 status after start
            echo "📊 PM2 status after startup:"
            pm2 status
            
            # Check logs for any startup errors
            echo "📋 Recent logs:"
            pm2 logs ultrazend --lines 10 --nostream || echo "No logs available"
            
            # Verify application is actually running
            if pm2 status | grep -q "online"; then
              echo "✅ Application started successfully"
            else
              echo "❌ Application failed to start - checking logs..."
              pm2 logs ultrazend --lines 20 --nostream || echo "No logs available"
              
              # Attempt rollback if backup exists
              if [ -d "backend/dist.backup.$TIMESTAMP" ]; then
                echo "🔄 Attempting rollback..."
                pm2 stop ultrazend || true
                pm2 delete ultrazend || true
                cd backend
                rm -rf dist
                mv dist.backup.$TIMESTAMP dist
                cd ..
                pm2 start ecosystem.config.js --env production
                echo "✅ Rollback completed"
              fi
              exit 1
            fi
          EOF

      # ===== POST-DEPLOY HEALTH CHECK =====
      - name: 🏥 Post-Deploy Health Check
        if: success() && (github.ref == 'refs/heads/main' || github.ref == 'refs/heads/develop')
        env:
          VPS_PASSWORD: ${{ secrets.VPS_PASSWORD }}
        run: |
          echo "🏥 Running comprehensive health checks..."
          
          # Wait for application to fully start
          sleep 20
          
          sshpass -p "$VPS_PASSWORD" ssh -o StrictHostKeyChecking=no root@31.97.162.155 << 'EOF'
            echo "🔍 Checking application status..."
            pm2 status
            
            echo "🌐 Testing health endpoints..."
            if curl -f -s -m 10 http://localhost:3001/health > /dev/null; then
              echo "✅ Backend health check: OK"
            else
              echo "❌ Backend health check: FAILED"
              exit 1
            fi
            
            if curl -f -s -m 10 http://localhost:3001/api/version > /dev/null; then
              echo "✅ Version endpoint: OK"
              echo "📋 Current version: $(curl -s http://localhost:3001/api/version | head -1)"
            else
              echo "⚠️ Version endpoint not available"
            fi
            
            echo "📧 Testing SMTP server..."
            if netstat -tlnp | grep -q ":25"; then
              echo "✅ SMTP server: Listening on port 25"
            else
              echo "⚠️ SMTP server: Not listening on port 25"
            fi
            
            echo "🔍 Checking logs for errors..."
            ERROR_COUNT=$(pm2 logs ultrazend --lines 50 --nostream 2>/dev/null | grep -i error | wc -l || echo 0)
            if [ "$ERROR_COUNT" -gt 0 ]; then
              echo "⚠️ Found $ERROR_COUNT errors in logs - please check"
            else
              echo "✅ No errors found in recent logs"
            fi
          EOF

      # ===== CREATE GIT TAG =====
      - name: 🏷️ Create Git Tag
        if: success() && github.ref == 'refs/heads/main'
        run: |
          VERSION="${{ steps.version.outputs.version }}"
          git config --global user.name "GitHub Actions"
          git config --global user.email "actions@github.com"
          git tag -a "v$VERSION" -m "Release version $VERSION"
          git push origin "v$VERSION"
          echo "✅ Created and pushed tag v$VERSION"

      # ===== DEPLOYMENT SUMMARY =====
      - name: 📊 Professional Deployment Summary
        if: always()
        run: |
          echo "📊 ===== ULTRAZEND PROFESSIONAL DEPLOYMENT SUMMARY ====="
          echo "🚀 Pipeline: UltraZend Professional CI/CD"
          echo "📅 Date: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
          echo "🌿 Branch: ${{ github.ref_name }}"
          echo "🏷️ Version: ${{ steps.version.outputs.version }}"
          echo "🔢 Build: #${{ steps.version.outputs.build_number }}"
          echo "🔖 Commit: ${{ steps.version.outputs.commit_sha }}"
          echo "👤 Triggered by: ${{ github.actor }}"
          echo ""
          
          if [ "${{ job.status }}" = "success" ]; then
            echo "✅ Status: SUCCESS"
            echo "🎉 UltraZend v${{ steps.version.outputs.version }} deployed successfully!"
            echo "🌐 Application URL: https://www.velomail.com.br"
            echo "🏥 Health Check: https://www.velomail.com.br/health"
          else
            echo "❌ Status: FAILED"
            echo "💥 Deployment failed - please check the logs above"
          fi
          
          echo ""
          echo "📋 Deployment Features:"
          echo "  ✅ Semantic versioning"
          echo "  ✅ Zero-downtime deployment"
          echo "  ✅ Automatic rollback on failure"
          echo "  ✅ Health checks"
          echo "  ✅ Cache busting"
          echo "  ✅ Force reload"
          echo ""
          echo "🔗 Build URL: ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}"
          echo "================================================="